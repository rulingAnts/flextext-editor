{
  "lang": "en",
  "id": "/",
  "name": "Flextext Consent Collector",
  "short_name": "Flextext Consent",
  "name_localized": { "id": "Pengumpul Izin Flextext" },
  "short_name_localized": { "id": "Izin Flextext" },
  "description": "Collect speaker permission for texts you already have, one at a time or for a whole speaker's work at once. Works offline.",
  "description_localized": { "id": "Kumpulkan izin penutur untuk teks yang sudah ada, satu per satu atau sekaligus untuk semua teks satu penutur. Bisa dipakai tanpa internet." },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "launch_handler": { "client_mode": "navigate-existing" },
  "background_color": "#ffffff",
  "theme_color": "#7c3aed",
  "icons": [
    { "src": "icons/consent-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/consent-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/consent-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/consent.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
