#!/usr/bin/env bash
# The pre-push guards, TRACKED so they can be reviewed and reinstalled.
#
# ⚠ .git/hooks IS NOT VERSION CONTROLLED, which is why this lives here and ./install-hooks.sh copies
# it in. A guard that exists only on one laptop protects only that laptop — and this repo is pushed
# from Seth's Mac, a KDE VM, and remote-execution containers.
#
# Four guards, in cost order — cheapest refusal first:
#   0. FRESHNESS    — work built on a stale checkout is work aimed at a tree that no longer exists.
#   1. SECRETS      — a credential pushed to a public repo cannot be unpublished. No override.
#   2. WORKFLOWS    — .github/workflows changes can incur GitHub billing (CLAUDE.md's cost policy).
#   3. PRODUCTION   — productionWeb is the live site field translators load.
#
# Overrides exist for 2 and 3 because they are POLICY (Seth approves a specific push), and
# deliberately NOT for 1, because "I know what I'm doing" is what every leaked key has in common.
# Genuinely need an exception? Widen OK_NAMES in check-secrets.sh, in the commit that needs it,
# where a reviewer can see it.

set -uo pipefail
repo="$(git rev-parse --show-toplevel)"

# ⚠ git gives a pre-push hook the remote NAME in $1 and the remote URL in $2. NEITHER IS A REF.
# The refs arrive on STDIN, one line per ref:
#     <local_ref> <local_sha> <remote_ref> <remote_sha>
#
# This is read ONCE, here, because stdin is a stream: the secrets guard below used to consume it,
# so anything reading it afterwards got nothing. Both halves of that trap were live until
# 2026-09-02 — the production guard was matching `*refs/heads/main*` against the remote URL, which
# can never contain it, so IT HAD NEVER FIRED. A `git push origin main` sailed through with no
# ALLOW_MAIN_PUSH and no complaint, which is how it was found.
#
# The lesson worth keeping: this guard was not weakened, it was never armed, and nothing said so.
# A hook that silently passes looks exactly like a hook that approves.
REFS="$(cat)"

# ── 0. FRESHNESS ──────────────────────────────────────────────────────────────────────────────
# Not about what this push would DO — git already refuses a non-fast-forward — but about what the
# work was built AGAINST. A branch forked from a months-old main pushes perfectly and is still
# wrong. Warn-only: by push time the work is already done, and blocking it helps nobody. The place
# this is meant to catch you is dev-serve.sh, before you write anything.
[ -x "$repo/check-freshness.sh" ] && "$repo/check-freshness.sh" --warn --quiet

# ── 1. SECRETS ────────────────────────────────────────────────────────────────────────────────
# Scan the commits actually being pushed, not the whole tree: fast, and it is what is leaving.
if [ -x "$repo/check-secrets.sh" ]; then
  range=""
  # Fed from the captured REFS, not stdin — see the note at the top.
  while read -r _local_ref _local_sha _remote_ref remote_sha; do
    [ -n "${_local_sha:-}" ] || continue
    case "$_local_sha" in *[!0]*) ;; *) continue ;; esac      # all-zeroes = a branch DELETE
    case "${remote_sha:-}" in
      ''|*[!0-9a-f]*) range="" ;;
      *[!0]*) range="$remote_sha..$_local_sha" ;;             # existing branch: just the new commits
      *)      range="" ;;                                      # new branch: no baseline, scan tracked
    esac
    if [ -n "$range" ]; then
      "$repo/check-secrets.sh" --range "$range" || exit 1
    else
      "$repo/check-secrets.sh" || exit 1
    fi
  done <<< "$REFS"
  # No stdin (e.g. run by hand): fall back to scanning everything tracked.
  [ -n "${range:-}" ] || "$repo/check-secrets.sh" >/dev/null || { "$repo/check-secrets.sh"; exit 1; }
fi

# ── 2. WORKFLOWS (billable — CLAUDE.md) ───────────────────────────────────────────────────────
if [ "${ALLOW_WORKFLOW_PUSH:-0}" != "1" ]; then
  if git diff --name-only "@{push}..HEAD" 2>/dev/null | grep -q '^\.github/workflows/' \
     || git diff --name-only origin/HEAD..HEAD 2>/dev/null | grep -q '^\.github/workflows/'; then
    echo "pre-push: this push changes .github/workflows/ — Actions minutes can be BILLABLE." >&2
    echo "          FREE (public repo + standard runners + no new schedule/larger runner)?" >&2
    echo "          Then go: ALLOW_WORKFLOW_PUSH=1 git push …   — established, not assumed." >&2
    echo "          Metered, or the pause is warranted for a NON-cost reason? Ask Seth." >&2
    exit 1
  fi
fi

# ── 3. PRODUCTION ─────────────────────────────────────────────────────────────────────────────
# Matched against the REMOTE ref (field 3 of each stdin line), which is what is actually being
# written. Both branches are guarded, as README.md documents: productionWeb is the live site, and
# main is the releasable trunk a release fast-forwards FROM — an unreviewed commit there is one
# ff-merge away from the field.
#
# ⚠ The point of this guard is the PAUSE, not the permission. It exists to stop an agent session
# that has not read the branch policy from pushing on momentum; the environment variable is a
# deliberate act that a careless run will not perform.
if [ "${ALLOW_MAIN_PUSH:-0}" != "1" ]; then
  blocked=""
  while read -r _l _ls remote_ref _rs; do
    case "$remote_ref" in
      refs/heads/productionWeb|refs/heads/main) blocked="${blocked}${blocked:+, }${remote_ref#refs/heads/}" ;;
    esac
  done <<< "$REFS"
  if [ -n "$blocked" ]; then
    echo "pre-push: refusing to push a production branch without an explicit go-ahead ($blocked)." >&2
    echo "          productionWeb is the live site field translators load; main is what a release" >&2
    echo "          fast-forwards from, so an unreviewed commit there is one merge from the field." >&2
    echo "          With Seth's sign-off:  ALLOW_MAIN_PUSH=1 git push origin $blocked" >&2
    exit 1
  fi
fi

exit 0
