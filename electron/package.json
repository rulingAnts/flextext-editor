{
  "name": "flextext-desktop",
  "version": "0.1.0",
  "description": "Desktop shell for the Flextext editor — exists solely for archive-quality audio capture.",
  "license": "AGPL-3.0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:local": "FLEXTEXT_URL=http://localhost:8012/flextext-editor/ electron .",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.flextext.desktop",
    "productName": "Flextext Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg.exe",
        "to": "ffmpeg.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Flextext-Desktop-${version}-x64-portable.exe"
    }
  },
  "author": "rulingAnts"
}
